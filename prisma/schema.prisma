// ebc-studio — Prisma schema.
//
// Two models: StudioReservation mirrors the public reserve form (see
// lib/reservation.ts) plus the fields a real reservation needs to be tracked —
// a public reference, a review status, and audit timestamps. Admin backs the
// staff login at /admin.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Review state of a reservation. The UI badges + detail text for each live in
/// RESERVATION_STATUSES in lib/reservation.ts — keep the two in sync.
enum ReservationStatus {
  pending
  confirmed
  declined
}

model StudioReservation {
  // Internal primary key. Not exposed to users.
  id Int @id @default(autoincrement())

  // Public reference sequence. The app formats this as `RES-${padStart(5)}`
  // (formatReference in lib/reservation.ts). The sequence is *seeded* to start
  // at 10001 by the seed SQL in `prisma/seed.ts`/migration, so generated
  // references match the RES-10001 shape the lookup form already accepts.
  referenceNo Int @unique @default(autoincrement())

  // --- Reserve form fields (lib/reservation.ts / app/reserve/reservation-form.tsx) ---
  fullName String
  email    String
  /// One of the values in CHANNELS (lib/reservation.ts): tv1 | tv2 | tv3 | news | entertainment.
  channel  String
  goal     String
  location String
  /// Amount the bidder plans to spend. Decimal for exact money; the UI shows it
  /// as "Br100.00 ETB" (CURRENCY in lib/reservation.ts).
  bid      Decimal @db.Decimal(12, 2)

  // --- Tracking ---
  status    ReservationStatus @default(pending)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Lookups are by the public reference ("RES-10001") or by email. Index both;
  // channel is indexed because reservations are grouped by channel when
  // scheduling.
  @@index([email])
  @@index([channel])
}

/// Runtime flags for the public site. A single row (id 1, seeded by its
/// migration) holds every site-wide switch; the reserve page reads
/// `reservationsPaused` on every request and the settings toggle writes it.
model SiteSettings {
  id Int @id @default(1)

  /// When true, the reserve form is replaced by a "paused" notice that points
  /// existing bookers at the check-reservation flow. Reads are trusted on the
  /// page and re-checked on the create action (the form hiding is not the gate).
  reservationsPaused Boolean @default(false)

  updatedAt DateTime @updatedAt
}

/// Staff account for /admin. There is no public signup route by design —
/// accounts are created by an existing admin from /admin/settings, so the first
/// row had to come from somewhere else (it was seeded by a CLI script that has
/// since been removed). No email and no password reset flow: the primary admin
/// deletes an account and issues fresh credentials instead.
model Admin {
  id Int @id @default(autoincrement())

  /// Stored lowercased; the login form lowercases what's typed before looking up.
  username String @unique

  /// scrypt digest as "saltHex:keyHex" — see lib/password.ts. Never the raw password.
  passwordHash String

  /// The one account that may delete admins. Every admin can *create* one.
  /// Set on the oldest row by the add_admin_primary migration and never
  /// written again — nothing in the app promotes or demotes, so "exactly one"
  /// holds without a partial unique index.
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
